	$(HL1_OBJ_DIR)/hud/status_icons.o \
	$(HL1_OBJ_DIR)/hud/statusbar.o \
	$(HL1_OBJ_DIR)/hud/text_message.o \
	$(HL1_OBJ_DIR)/hud/train.o \
	$(HL1_OBJ_DIR)/studio/GameStudioModelRenderer.o \
	$(HL1_OBJ_DIR)/input/in_camera.o \
	$(HL1_OBJ_DIR)/input/input.o \
	$(HL1_OBJ_DIR)/input/inputw32.o \
	$(HL1_OBJ_DIR)/input/input_hardware.o \
	$(HL1_OBJ_DIR)/studio/studio_util.o \
	$(HL1_OBJ_DIR)/studio/StudioModelRenderer.o \
	$(HL1_OBJ_DIR)/render/tri.o \
	$(HL1_OBJ_DIR)/core/util.o \
	$(HL1_OBJ_DIR)/render/view.o \
