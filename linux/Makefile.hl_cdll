	$(HL1_OBJ_DIR)/VGUI/vgui_int.o \
	$(HL1_OBJ_DIR)/VGUI/vgui_ClassMenuPanel.o \
	$(HL1_OBJ_DIR)/VGUI/vgui_ControlConfigPanel.o \
	$(HL1_OBJ_DIR)/VGUI/vgui_CustomObjects.o \
	$(HL1_OBJ_DIR)/VGUI/vgui_MOTDWindow.o \
	$(HL1_OBJ_DIR)/VGUI/vgui_SchemeManager.o \
	$(HL1_OBJ_DIR)/VGUI/vgui_ScorePanel.o \
	$(HL1_OBJ_DIR)/VGUI/vgui_ServerBrowser.o \
	$(HL1_OBJ_DIR)/VGUI/vgui_TeamFortressViewport.o \
	$(HL1_OBJ_DIR)/VGUI/vgui_viewport_menus.o \
	$(HL1_OBJ_DIR)/VGUI/vgui_viewport_messages.o \
	$(HL1_OBJ_DIR)/VGUI/vgui_CommandMenuPanel.o \
	$(HL1_OBJ_DIR)/VGUI/vgui_SpectatorPanel.o \
	$(HL1_OBJ_DIR)/VGUI/vgui_TeamMenuPanel.o \
	$(HL1_OBJ_DIR)/hud/voice_status.o \
	$(HL1_OBJ_DIR)/hud/hud_servers.o \


DLL_OBJS = \
	$(HL1_SERVER_OBJ_DIR)/weapons/weapon_crossbow.o \
	$(HL1_SERVER_OBJ_DIR)/weapons/weapon_crowbar.o \
	$(HL1_SERVER_OBJ_DIR)/weapons/weapon_egon.o \
	$(HL1_SERVER_OBJ_DIR)/weapons/weapon_gauss.o \
	$(HL1_SERVER_OBJ_DIR)/weapons/weapon_handgrenade.o \
	$(HL1_SERVER_OBJ_DIR)/weapons/weapon_hornetgun.o \
	$(HL1_SERVER_OBJ_DIR)/weapons/weapon_mp5.o \
	$(HL1_SERVER_OBJ_DIR)/weapons/weapon_python.o \
