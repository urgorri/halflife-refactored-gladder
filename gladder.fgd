//=============================================================================
// Half-Life: Gladder - Forge Game Data (.fgd)
//
// Level editor definition file for the Half-Life: Gladder arcade gauntlet mod.
// Compatible with:
//   - Valve Hammer Editor 3.4 / 3.5
//   - J.A.C.K. (Jackhammer)
//   - TrenchBroom (GoldSrc game profile)
//   - Sledge
//
// Map Editor Setup:
// -----------------
// 1. Valve Hammer Editor / J.A.C.K.:
//    - Open Tools -> Options -> Game Configurations.
//    - Under "Game Data files", ensure standard "halflife.fgd" is loaded first.
//    - Click "Add..." and select "gladder.fgd" from this repository root.
//    (Note: If your editor supports @include and halflife.fgd is in the editor's
//     search path or working directory, the @include directive below will load
//     it automatically. If your editor loads halflife.fgd separately and warns
//     about duplicate class definitions, comment out the @include line below.)
//
// 2. TrenchBroom:
//    - In your GoldSrc game configuration file (GameConfig.cfg), reference both
//      "halflife.fgd" and "gladder.fgd" in the entityDefinitions array:
//      "files": [ "halflife.fgd", "gladder.fgd" ]
//
// Maintenance Rule for Contributors:
// ----------------------------------
// Whenever a new map entity (LINK_ENTITY_TO_CLASS) is added to the mod, its
// definition MUST be documented in this file with accurate properties, choices,
// and spawnflags to preserve compatibility with level design tools.
//=============================================================================

@include "halflife.fgd"

//=============================================================================
//
// Gladder Triggers & Gauntlet Volumes
//
//=============================================================================

@SolidClass base(Trigger) = trigger_gladder_start : "Gladder: Wave Start Trigger"
[
	spawnflags(flags) =
	[
		1 : "Monsters" : 0
		2 : "No Clients" : 0
		4 : "Pushables" : 0
	]
]

@SolidClass base(Trigger) = trigger_gladder_finish : "Gladder: Wave Finish Trigger"
[
	target(target_destination) : "Teleport Target Destination (Point A)"
	spawnflags(flags) =
	[
		1 : "Monsters" : 0
		2 : "No Clients" : 0
		4 : "Pushables" : 0
	]
]

@SolidClass base(Targetname) = trigger_gladder_area : "Gladder: Spatial Area Volume / Indexer"
[
	netname(string) : "Area Name" : "" : "Unique sector label or identifier for this spatial section (e.g., Sector 1 - Pasillo Central)."
	areaname(string) : "Area Name (Legacy)" : "" : "Alternative identifier for this spatial section."
	areaid(integer) : "Area ID" : 0 : "Numeric index for spatial entity indexing and procedural monster spawn budgets."
]

//=============================================================================
//
// Gladder Logic & Wave Relays
//
//=============================================================================

@PointClass base(Targetname, Targetx) color(200 180 0) = gladder_wave_relay : "Gladder: Wave Event Relay"
[
	wave_event(choices) : "Wave Event Trigger" : 0 : "Specifies which game rules wave transition fires this relay's target." =
	[
		0 : "On Wave Start (crossing Point A)"
		1 : "On Wave Win / Completed (reaching Point B)"
		2 : "On Match Over / Victory (all laps finished)"
		3 : "On Player Death / Defeat"
	]
]

//=============================================================================
//
// Gladder Interactive World Entities
//
//=============================================================================

@SolidClass base(Breakable, RenderFields) = gladder_breakable : "Gladder: Wave-Resettable Breakable"
[
	spawnflags(flags) =
	[
		1 : "Only Trigger" : 0
		2 : "Touch" : 0
		4 : "Pressure" : 0
		256: "Instant Crowbar" : 1
	]
	_minlight(string) : "Minimum light level"
	zhlt_lightflags(choices) : "ZHLT Lightflags" : 0 =
	[
		0 : "Default"
		1 : "Embedded Fix"
		2 : "Opaque (blocks light)"
		3 : "Opaque + Embedded fix"
	]
	light_origin(string) : "Light Origin Target"
]

//=============================================================================
//
// Gladder Collectibles & Pickups
//
//=============================================================================

@PointClass base(Targetname) studio("models/item_collectible.mdl") color(255 140 20) = item_gladder_lambda : "Gladder: Collectible Item (Lambda Insignia)"
[
]

@PointClass base(Targetname) studio("models/item_collectible.mdl") color(255 140 20) = item_gladder_collectible : "Gladder: Collectible Item (Alias)"
[
]

//=============================================================================
//
// Opposing Force Extended Arsenal & Ammunition
//
//=============================================================================

@PointClass base(Weapon, Targetx, RenderFields) studio("models/w_knife.mdl") = weapon_knife : "Combat Knife" []
@PointClass base(Weapon, Targetx, RenderFields) studio("models/w_pipe_wrench.mdl") = weapon_pipewrench : "Pipe Wrench" []
@PointClass base(Weapon, Targetx, RenderFields) studio("models/w_desert_eagle.mdl") = weapon_eagle : "Desert Eagle .357" []
@PointClass base(Weapon, Targetx, RenderFields) studio("models/w_m40a1.mdl") = weapon_sniper : "M40A1 Sniper Rifle" []
@PointClass base(Weapon, Targetx, RenderFields) studio("models/w_saw.mdl") = weapon_m249 : "M249 SAW" []

@PointClass base(Targetx, RenderFields) studio("models/w_m40a1clip.mdl") = ammo_762 : "7.62mm Sniper Ammo Clip" []
@PointClass base(Targetx, RenderFields) studio("models/w_saw_clip.mdl") = ammo_556 : "5.56mm SAW Ammo Box" []
